# Rust build artifacts
/target/

# Build outputs and reports
/out/
/site/
/dist/
/test-results/

# Emulator runtime state (auto-generated by local emulator runs)
/cfg/
/nvram/

# Generated game data includes
/src/generated/*
!/src/generated/README.md
/src/chars/*/generated/

# Generated web bundle inputs (rebuilt by `make web-sync`)
/web/dist/
/web/tmp/
/web/public/rom/smash.nes
/web/public/info/build.json
/web/public/snaps/
/web/public/docs/

# Local editor and OS noise
.DS_Store
*.swp
*.swo
*.tmp
*.log
.vscode/
.idea/
