---
import '../styles/site.css';
import ArtThemeProvider from '../components/themes/ArtThemeProvider.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = 'Four fighters. One platform. A real NES platform fighter.', wide = false } = Astro.props;
---
<!doctype html>
<html lang="en" data-art-theme="b">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="theme-color" content="#121914"/>
    <title>{title} · Smash.NES</title><link rel="icon" href="/assets/favicon.svg"/>
    <link rel="preload" href="/assets/fonts/cartridge.woff2" as="font" type="font/woff2" crossorigin/>
    <ArtThemeProvider />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <div class:list={['site-wrap', { 'site-wrap-wide': wide }]}>
      <header class="site-header"><SiteHeader /></header>
      <main id="main"><slot/></main>
      <footer><SiteFooter /></footer>
    </div>
  </body>
</html>
