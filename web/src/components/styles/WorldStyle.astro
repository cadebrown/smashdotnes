---
import { roster } from '../../data/roster';

const poseStyle = (fighter: typeof roster[number], index: number) =>
  `--sheet:url('/assets/fighters/${fighter.id}.png');--pose:${fighter.pose};--frames:${fighter.frames};--crop-x:${fighter.x};--crop-y:${fighter.y};--crop-width:${fighter.width};--crop-height:${fighter.height};--scale:${fighter.smallScale};--order:${index}`;
---

<section class="world-style" aria-label="Smash.NES world homepage">
  <header class="world-style__nav">
    <a class="world-style__brand" href="/">SMASH<span>.NES</span></a>
    <nav aria-label="Main navigation">
      <a href="/book/">Fighters</a>
      <a href="/docs/">How it works</a>
      <a class="world-style__nav-play" href="/play/">Play</a>
    </nav>
  </header>

  <div class="world-style__scene">
    <div class="world-style__sun" aria-hidden="true"></div>
    <div class="world-style__cloud world-style__cloud--one" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="world-style__cloud world-style__cloud--two" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="world-style__title">
      <p>Four fighters. One platform.</p>
      <h2>SMASH<br/><span>NES</span></h2>
      <a href="/play/" class="world-style__start">Start a match <b aria-hidden="true">▶</b></a>
    </div>

    <div class="world-style__hill world-style__hill--back" aria-hidden="true"></div>
    <div class="world-style__hill world-style__hill--front" aria-hidden="true"></div>

    <div class="world-style__platform world-style__platform--high" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="world-style__platform world-style__platform--main" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <div class="world-style__fighters" aria-label="Meet the fighters">
      {roster.map((fighter, index) => (
        <a
          class={`world-style__fighter world-style__fighter--${fighter.id}`}
          href={`/book/#${fighter.anchor}`}
          style={poseStyle(fighter, index)}
        >
          <span class="world-style__sprite" aria-hidden="true"></span>
          <span class="world-style__fighter-name">{fighter.name}</span>
          <span class="world-style__fighter-move">{fighter.move}</span>
        </a>
      ))}
    </div>
    <div class="world-style__ground" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </div>

  <div class="world-style__after">
    <div>
      <p>Play it your way</p>
      <h3>Jump in, pick a fighter, hold the platform.</h3>
    </div>
    <div class="world-style__links">
      <a href="/book/"><b>Meet the fighters</b><span>Moves, matchups, and the four ways to start trouble.</span><i aria-hidden="true">→</i></a>
      <a href="/docs/"><b>Open the cartridge</b><span>See the sprites, systems, and NES code inside.</span><i aria-hidden="true">→</i></a>
    </div>
  </div>
</section>

<style>
  .world-style { --sky:#77c7e5; --milk:#f9fff0; --leaf:#ccf58b; --indigo:#2739a3; --coral:#e6684e; color:var(--indigo); background:var(--milk); font-family:Arial,Helvetica,sans-serif; overflow:hidden; }
  .world-style *, .world-style *::before, .world-style *::after { box-sizing:border-box; }
  .world-style__nav { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:24px; max-width:1240px; padding:14px clamp(18px,4vw,54px); margin:auto; }
  .world-style__brand { color:var(--indigo); font:400 clamp(20px,2.2vw,29px)/1 'Cartridge',monospace; letter-spacing:-.06em; text-decoration:none; white-space:nowrap; }
  .world-style__brand span { color:var(--coral); }
  .world-style__nav nav { display:flex; align-items:center; gap:clamp(14px,2.7vw,36px); font:700 13px/1 Arial,sans-serif; }
  .world-style__nav nav a { color:var(--indigo); text-decoration:none; white-space:nowrap; }
  .world-style__nav nav a:not(.world-style__nav-play):hover { text-decoration:underline; text-decoration-thickness:2px; text-underline-offset:5px; }
  .world-style__nav-play { padding:10px 14px 9px; color:var(--milk)!important; background:var(--indigo); box-shadow:4px 4px 0 var(--coral); }
  .world-style__nav-play:hover { transform:translate(2px,2px); box-shadow:2px 2px 0 var(--coral); }
  .world-style__nav a:focus-visible,.world-style__scene a:focus-visible,.world-style__after a:focus-visible { outline:3px solid var(--coral); outline-offset:4px; }

  .world-style__scene { position:relative; min-height:clamp(465px,48vw,670px); isolation:isolate; overflow:hidden; background:var(--sky); border-block:6px solid var(--indigo); }
  .world-style__sun { position:absolute; z-index:-4; width:clamp(88px,11vw,158px); aspect-ratio:1; top:9%; right:13%; background:#fff4a8; box-shadow:10px 10px 0 #f7d363; }
  .world-style__cloud { position:absolute; z-index:-3; width:clamp(90px,14vw,180px); height:36px; color:var(--milk); }
  .world-style__cloud i { position:absolute; bottom:0; display:block; background:currentColor; }
  .world-style__cloud i:nth-child(1) { left:0; width:48%; height:44%; }.world-style__cloud i:nth-child(2) { left:23%; width:43%; height:77%; }.world-style__cloud i:nth-child(3) { right:0; width:40%; height:57%; }
  .world-style__cloud--one { top:13%; left:7%; }.world-style__cloud--two { top:32%; right:5%; transform:scale(.62); transform-origin:right center; }
  .world-style__title { position:absolute; z-index:4; top:clamp(38px,7vw,95px); left:clamp(20px,9vw,142px); }
  .world-style__title p { margin:0 0 10px; color:var(--indigo); font:700 clamp(10px,1vw,14px)/1.3 Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
  .world-style__title h2 { margin:0; color:var(--milk); font:400 clamp(54px,9.3vw,142px)/.92 'Cartridge',monospace; letter-spacing:-.08em; text-shadow:5px 5px 0 var(--indigo),10px 10px 0 var(--coral); }
  .world-style__title h2 span { margin-left:.3em; color:var(--leaf); }
  .world-style__start { display:inline-flex; align-items:center; gap:12px; margin-top:26px; padding:13px 17px 12px; color:var(--milk); background:var(--coral); box-shadow:5px 5px 0 var(--indigo); font:400 15px/1 'Cartridge',monospace; text-decoration:none; }
  .world-style__start b { font:400 11px/1 Arial,sans-serif; }.world-style__start:hover { transform:translate(3px,3px); box-shadow:2px 2px 0 var(--indigo); }
  .world-style__hill { position:absolute; z-index:-2; bottom:68px; width:48%; height:31%; background:var(--leaf); clip-path:polygon(0 100%,0 67%,13% 67%,13% 50%,28% 50%,28% 34%,43% 34%,43% 17%,57% 17%,57% 34%,72% 34%,72% 50%,87% 50%,87% 67%,100% 67%,100% 100%); }
  .world-style__hill--back { left:32%; background:#98d891; }.world-style__hill--front { right:-11%; height:36%; background:#b7e883; }
  .world-style__platform { position:absolute; z-index:1; height:24px; background:var(--milk); border:5px solid var(--indigo); box-shadow:0 7px 0 var(--coral); }
  .world-style__platform::after { content:''; position:absolute; left:11%; right:11%; top:6px; height:5px; border-inline:5px solid var(--indigo); }
  .world-style__platform i { position:absolute; top:19px; width:18px; height:26px; background:var(--indigo); }.world-style__platform i:nth-child(1){left:7%;}.world-style__platform i:nth-child(2){left:26%;}.world-style__platform i:nth-child(3){right:26%;}.world-style__platform i:nth-child(4){right:7%;}.world-style__platform i:nth-child(5){left:45%;}.world-style__platform i:nth-child(6){right:45%;}
  .world-style__platform--main { left:30%; right:8%; bottom:133px; }.world-style__platform--high { width:25%; right:15%; bottom:302px; transform:scale(.72); transform-origin:right bottom; }
  .world-style__fighters { position:absolute; z-index:3; inset:0; pointer-events:none; }
  .world-style__fighter { --lift:0px; position:absolute; display:grid; place-items:center; width:112px; color:var(--indigo); text-align:center; text-decoration:none; pointer-events:auto; transition:transform .18s steps(2,end); transform:translateY(var(--lift)); }
  .world-style__fighter:hover,.world-style__fighter:focus-visible { --lift:-12px; }
  .world-style__sprite { display:block; width:calc(var(--crop-width) * var(--scale) * 1px); height:calc(var(--crop-height) * var(--scale) * 1px); margin-bottom:3px; background-image:var(--sheet); background-repeat:no-repeat; background-size:calc(var(--frames) * 32px * var(--scale)) calc(40px * var(--scale)); background-position:calc((var(--pose) * 32 + var(--crop-x)) * var(--scale) * -1px) calc(var(--crop-y) * var(--scale) * -1px); image-rendering:pixelated; }
  .world-style__fighter-name { padding:4px 6px 2px; color:var(--milk); background:var(--indigo); font:400 11px/1 'Cartridge',monospace; }.world-style__fighter-move { margin-top:4px; padding:2px 4px; background:var(--milk); font:700 9px/1 Arial,sans-serif; }
  .world-style__fighter--mario { left:30%; bottom:153px; }.world-style__fighter--simon { left:48%; bottom:153px; }.world-style__fighter--tommy { right:11%; bottom:302px; }.world-style__fighter--rizer { right:3%; bottom:153px; }
  .world-style__ground { position:absolute; z-index:2; inset:auto 0 0; height:68px; background:var(--indigo); border-top:6px solid var(--milk); box-shadow:0 -12px 0 var(--leaf); }.world-style__ground i { display:inline-block; width:44px; height:22px; margin:25px 9% 0 0; background:var(--coral); }.world-style__ground i:nth-child(2n){background:var(--leaf);}.world-style__ground i:nth-child(3n){width:24px;background:var(--milk);}

  .world-style__after { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(26px,7vw,90px); max-width:1120px; padding:clamp(34px,6vw,72px) clamp(18px,4vw,54px); margin:auto; }.world-style__after p { margin:0 0 10px; color:var(--coral); font:400 13px/1 'Cartridge',monospace; }.world-style__after h3 { margin:0; max-width:13ch; font:400 clamp(25px,3.3vw,46px)/1.05 'Cartridge',monospace; letter-spacing:-.045em; }
  .world-style__links { display:grid; align-content:start; border-top:4px solid var(--indigo); }.world-style__links a { position:relative; display:grid; grid-template-columns:1fr auto; gap:7px 16px; padding:20px 32px 20px 0; color:var(--indigo); border-bottom:2px solid #2739a340; text-decoration:none; }.world-style__links a:hover { color:var(--coral); }.world-style__links b { font:400 19px/1 'Cartridge',monospace; }.world-style__links span { grid-column:1; font:400 13px/1.4 Arial,sans-serif; }.world-style__links i { grid-column:2; grid-row:1 / span 2; align-self:center; font:400 28px/1 Arial,sans-serif; }
  @media (prefers-reduced-motion:no-preference) { :global(html:not([data-style-motion=off])) .world-style__cloud--one { animation:world-cloud-one 12s linear infinite alternate; } :global(html:not([data-style-motion=off])) .world-style__cloud--two { animation:world-cloud-two 17s linear infinite alternate; } :global(html:not([data-style-motion=off])) .world-style__fighter:hover .world-style__sprite { animation:world-jump .35s steps(2,end) infinite alternate; } }
  @keyframes world-cloud-one { to { transform:translateX(48px); } } @keyframes world-cloud-two { to { transform:translateX(-65px) scale(.62); } } @keyframes world-jump { to { transform:translateY(-7px); } }
  @media (max-width:1000px) {
    .world-style__nav { min-height:61px; }
    .world-style__nav nav { gap:13px; font-size:11px; }
    .world-style__nav-play { padding:8px 10px 7px; box-shadow:3px 3px 0 var(--coral); }
    .world-style__scene { min-height:620px; }
    .world-style__title { top:40px; left:20px; right:20px; text-align:center; }
    .world-style__title h2 { font-size:clamp(54px,11vw,96px); }
    .world-style__title h2 span { margin-left:0; }
    .world-style__title p { font-size:10px; }
    .world-style__start { margin-top:22px; padding:12px 16px; font-size:13px; }
    .world-style__hill--back { left:5%; bottom:68px; width:52%; height:23%; }
    .world-style__hill--front { right:-19%; height:25%; }
    .world-style__platform--main { left:5%; right:5%; bottom:139px; }
    .world-style__platform--high { display:none; }
    .world-style__fighter { width:90px; bottom:160px; }
    .world-style__fighter--mario { left:calc(17% - 45px); }
    .world-style__fighter--simon { left:calc(39% - 45px); }
    .world-style__fighter--tommy { right:auto; left:calc(61% - 45px); }
    .world-style__fighter--rizer { right:auto; left:calc(83% - 45px); }
    .world-style__after { grid-template-columns:1fr; }
    .world-style__after h3 { max-width:24ch; }
    .world-style__ground i { margin-right:6%; }
  }
  @media (max-width:500px) {
    .world-style__nav nav a:not(.world-style__nav-play) { display:none; }
    .world-style__scene { min-height:540px; }
    .world-style__title { top:35px; }
    .world-style__title h2 { font-size:clamp(48px,15vw,69px); }
    .world-style__title p { font-size:9px; letter-spacing:.02em; }
    .world-style__fighter { width:69px; bottom:139px; }
    .world-style__sprite { --scale:3; }
    .world-style__fighter-name { font-size:9px; }
    .world-style__fighter-move { font-size:8px; white-space:nowrap; }
    .world-style__fighter--mario { left:calc(15.5% - 34.5px); }
    .world-style__fighter--simon { left:calc(38.5% - 34.5px); }
    .world-style__fighter--tommy { left:calc(61.5% - 34.5px); }
    .world-style__fighter--rizer { left:calc(84.5% - 34.5px); }
    .world-style__platform--main { bottom:118px; }
    .world-style__sun { top:12%; right:3%; width:65px; }
  }
  :global(html[data-style-motion=off]) .world-style *, :global(html[data-style-motion=off]) .world-style *::before, :global(html[data-style-motion=off]) .world-style *::after { animation:none!important; transition:none!important; }
  @media (prefers-reduced-motion:reduce) { .world-style *, .world-style *::before, .world-style *::after { animation:none!important; transition:none!important; } }
</style>
