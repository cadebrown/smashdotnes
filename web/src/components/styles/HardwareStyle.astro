---
import { roster } from '../../data/roster';

const mario = roster.find((fighter) => fighter.id === 'mario')!;
const rizer = roster.find((fighter) => fighter.id === 'rizer')!;
const spriteStyle = (fighter: (typeof roster)[number], scale: number) => `--sheet:url('/assets/fighters/${fighter.id}.png');--frame:${fighter.pose};--frames:${fighter.frames};--crop-x:${fighter.x};--crop-y:${fighter.y};--crop-width:${fighter.width};--crop-height:${fighter.height};--scale:${scale}`;
---

<section class="hardware-style" aria-label="Hardware style home page preview">
  <header class="hardware-style__header">
    <a class="hardware-style__mark" href="/" aria-label="Smash NES home">
      <span>SMASH</span><b>.NES</b>
    </a>
    <nav class="hardware-style__nav" aria-label="Preview navigation">
      <a href="/play/">Play</a>
      <a href="/book/">Book</a>
      <a href="/docs/">Docs</a>
      <a href="/blog/">Blog</a>
    </nav>
  </header>

  <div class="hardware-style__main">
    <div class="hardware-style__intro">
      <p class="hardware-style__edition">NES FIGHTING SYSTEM / 2026</p>
      <h2>Built for the<br /><em>next round.</em></h2>
      <p class="hardware-style__summary">A four-fighter brawler for the original Nintendo Entertainment System. Learn the moves, read the frame data, then take the stage.</p>
      <a class="hardware-style__play" href="/play/">
        <span class="hardware-style__play-icon" aria-hidden="true"></span>
        <span>Play Smash.NES</span>
      </a>
    </div>

    <div class="hardware-style__machine" aria-label="Smash NES battle display">
      <div class="hardware-style__ribs hardware-style__ribs--top" aria-hidden="true"></div>
      <div class="hardware-style__cartridge">
        <div class="hardware-style__cartridge-tabs" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="hardware-style__screen-bezel">
          <img src="/assets/captures/03_battle.png" alt="Mario and Simon battling on the Smash.NES stage" />
        </div>
        <div class="hardware-style__cartridge-label">
          <span>SMASH.NES</span>
          <small>FIGHTER CARTRIDGE</small>
        </div>
      </div>
      <div class="hardware-style__status">
        <span><i></i> POWER</span>
        <span>2 PLAYERS</span>
      </div>
      <div class="hardware-style__ribs hardware-style__ribs--bottom" aria-hidden="true"></div>
      <span class="hardware-style__screw hardware-style__screw--a" aria-hidden="true"></span>
      <span class="hardware-style__screw hardware-style__screw--b" aria-hidden="true"></span>
    </div>
  </div>

  <section class="hardware-style__lower" aria-label="Game guides">
    <a class="hardware-style__guide" href="/book/">
      <span class="hardware-style__fighter hardware-style__fighter--mario" style={spriteStyle(mario, 4)} aria-hidden="true"></span>
      <span><b>01</b><strong>Know your fighter</strong><small>Moves, timing, and matchups.</small></span>
    </a>
    <a class="hardware-style__guide" href="/docs/">
      <span class="hardware-style__fighter hardware-style__fighter--rizer" style={spriteStyle(rizer, 4)} aria-hidden="true"></span>
      <span><b>02</b><strong>Read the system</strong><small>Engine notes and build docs.</small></span>
    </a>
    <a class="hardware-style__archive" href="/blog/">
      <span>DEVELOPER LOG</span>
      <strong>New builds<br />from the bench <i aria-hidden="true">→</i></strong>
    </a>
  </section>
</section>

<style>
  .hardware-style {
    --shell: #d9d8d0;
    --panel: #f2f0e8;
    --ink: #2b2928;
    --red: #b62739;
    --line: #aaa8a0;
    --deep-line: #77746e;
    color:var(--ink);
    background:var(--shell);
    font-family:Arial, Helvetica, sans-serif;
    border:1px solid var(--line);
    box-shadow:inset 0 1px #fffefa;
    overflow:hidden;
    min-width:0;
  }
  .hardware-style *, .hardware-style *::before, .hardware-style *::after { box-sizing:border-box; }
  .hardware-style a { color:inherit; }
  .hardware-style a:is(.hardware-style__play,.hardware-style__archive) { color:#fff; }
  .hardware-style__header { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:66px; padding:12px clamp(18px, 4vw, 56px); border-bottom:1px solid var(--line); }
  .hardware-style__mark { display:inline-flex; align-items:baseline; gap:2px; color:var(--ink); font-weight:900; font-size:18px; letter-spacing:-.09em; text-decoration:none; white-space:nowrap; }
  .hardware-style__mark b { color:var(--red); letter-spacing:-.06em; }
  .hardware-style__nav { display:flex; justify-content:flex-end; gap:clamp(10px, 2.4vw, 31px); min-width:0; }
  .hardware-style__nav a { font-size:11px; font-weight:700; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; white-space:nowrap; }
  .hardware-style__nav a:hover { color:var(--red); }
  .hardware-style a:focus-visible { outline:3px solid var(--red); outline-offset:4px; }
  .hardware-style__main { display:grid; grid-template-columns:minmax(190px, .77fr) minmax(0, 1.23fr); align-items:center; gap:clamp(24px, 5vw, 80px); max-width:1280px; margin:0 auto; padding:clamp(38px, 7vw, 104px) clamp(18px, 6vw, 88px) clamp(34px, 6vw, 82px); }
  .hardware-style__intro { position:relative; z-index:1; }
  .hardware-style__edition { margin:0 0 17px; color:var(--red); font:400 8px/1.45 var(--pixel, monospace); letter-spacing:.08em; }
  .hardware-style h2 { max-width:8ch; margin:0; font:900 clamp(31px, 5.25vw, 76px)/.88 Arial, Helvetica, sans-serif; letter-spacing:-.075em; text-transform:uppercase; }
  .hardware-style h2 em { color:var(--red); font-style:normal; }
  .hardware-style__summary { max-width:34ch; margin:24px 0 28px; font-size:14px; line-height:1.48; }
  .hardware-style__play { display:inline-flex; align-items:center; gap:11px; padding:12px 16px 12px 12px; color:#fff; background:var(--red); box-shadow:0 4px 0 #791925; font-size:12px; font-weight:800; letter-spacing:.035em; text-decoration:none; text-transform:uppercase; transition:transform 120ms ease, box-shadow 120ms ease; }
  .hardware-style__play:hover { transform:translateY(2px); box-shadow:0 2px 0 #791925; }
  .hardware-style__play:active { transform:translateY(4px); box-shadow:0 0 0 #791925; }
  .hardware-style__play-icon { display:block; width:24px; height:24px; border-radius:50%; background:#f6e6e3; box-shadow:inset 0 0 0 2px #8c1c2a; position:relative; }
  .hardware-style__play-icon::after { content:''; position:absolute; top:7px; left:9px; border-width:5px 0 5px 7px; border-style:solid; border-color:transparent transparent transparent var(--red); }
  .hardware-style__machine { position:relative; width:min(100%, 710px); justify-self:end; padding:clamp(17px, 3vw, 35px); background:linear-gradient(145deg, #eeece4, #cfcec7 61%, #e3e1da); border:1px solid #a5a29a; border-radius:14px 14px 48px 14px; box-shadow:12px 15px 0 #a6a49d; transform:rotate(-2.2deg); animation:hardware-arrive 520ms cubic-bezier(.2,.9,.2,1) both; }
  .hardware-style__ribs { position:absolute; left:clamp(20px, 5vw, 54px); right:clamp(20px, 5vw, 54px); height:9px; background:repeating-linear-gradient(90deg, transparent 0 7px, #a8a69e 7px 10px, transparent 10px 16px); opacity:.8; }
  .hardware-style__ribs--top { top:13px; } .hardware-style__ribs--bottom { bottom:12px; }
  .hardware-style__cartridge { position:relative; padding:clamp(13px, 2.3vw, 25px) clamp(13px, 2.7vw, 30px) 0; background:#343231; border:5px solid #1f1e1e; border-radius:8px 8px 3px 3px; box-shadow:inset 0 0 0 2px #55524f, 0 6px 0 #918f89; }
  .hardware-style__cartridge-tabs { position:absolute; display:flex; top:-9px; left:12%; width:76%; justify-content:space-between; } .hardware-style__cartridge-tabs i { display:block; width:18%; height:7px; background:#272525; border-radius:3px 3px 0 0; }
  .hardware-style__screen-bezel { border:7px solid #171717; background:#171717; box-shadow:inset 0 0 0 2px #5d5953; overflow:hidden; }
  .hardware-style__screen-bezel img { display:block; width:100%; height:auto; aspect-ratio:4 / 3; object-fit:cover; image-rendering:auto; }
  .hardware-style__cartridge-label { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:46px; padding:8px 4px; color:#ebe6d8; letter-spacing:.04em; }
  .hardware-style__cartridge-label span { font:400 clamp(8px, 1.35vw, 13px)/1 var(--pixel, monospace); } .hardware-style__cartridge-label small { color:#c1bbb0; font-size:7px; font-weight:700; letter-spacing:.12em; }
  .hardware-style__status { display:flex; justify-content:space-between; gap:12px; padding:13px 3px 2px; color:#5d5a55; font-size:8px; font-weight:800; letter-spacing:.1em; }
  .hardware-style__status span:first-child { display:flex; align-items:center; gap:5px; } .hardware-style__status i { width:6px; height:6px; border-radius:50%; background:var(--red); box-shadow:0 0 0 1px #7e2730; }
  .hardware-style__screw { position:absolute; width:8px; height:8px; border:1px solid #85827b; border-radius:50%; background:linear-gradient(135deg, transparent 43%, #817e76 44% 56%, transparent 57%); } .hardware-style__screw--a { left:13px; top:16px; } .hardware-style__screw--b { right:13px; bottom:16px; }
  .hardware-style__lower { display:grid; grid-template-columns:1fr 1fr minmax(180px, .7fr); border-top:1px solid var(--line); background:var(--panel); }
  .hardware-style__guide, .hardware-style__archive { position:relative; min-height:139px; padding:23px clamp(18px, 3vw, 42px); text-decoration:none; overflow:hidden; }
  .hardware-style__guide { display:flex; align-items:flex-start; gap:15px; border-right:1px solid var(--line); } .hardware-style__guide:hover { background:#e8e6dc; }
  .hardware-style__guide > span:last-child { display:grid; gap:3px; position:relative; z-index:1; } .hardware-style__guide b { color:var(--red); font-size:10px; letter-spacing:.08em; } .hardware-style__guide strong { font-size:15px; line-height:1.1; text-transform:uppercase; } .hardware-style__guide small { max-width:19ch; color:#66635e; font-size:11px; line-height:1.25; }
  .hardware-style__fighter { flex:0 0 auto; width:calc(var(--crop-width) * var(--scale) * 1px); height:calc(var(--crop-height) * var(--scale) * 1px); background-image:var(--sheet); background-repeat:no-repeat; background-size:calc(var(--frames) * 32px * var(--scale)) calc(40px * var(--scale)); background-position:calc((var(--frame) * 32 + var(--crop-x)) * var(--scale) * -1px) calc(var(--crop-y) * var(--scale) * -1px); image-rendering:pixelated; transform:translateY(2px); }
  .hardware-style__archive { display:flex; flex-direction:column; justify-content:space-between; color:#fff; background:var(--ink); } .hardware-style__archive:hover { background:#3d3a38; } .hardware-style__archive span { color:#e1aab1; font:400 8px/1 var(--pixel, monospace); letter-spacing:.08em; } .hardware-style__archive strong { font-size:16px; line-height:1.04; text-transform:uppercase; } .hardware-style__archive i { color:#dc6170; font-size:24px; font-style:normal; vertical-align:-2px; }
  @keyframes hardware-arrive { from { opacity:0; transform:translate(18px, 12px) rotate(-2.2deg); } to { opacity:1; transform:rotate(-2.2deg); } }
  @media (max-width:680px) { .hardware-style__header { align-items:flex-start; } .hardware-style__nav { flex-wrap:wrap; gap:8px 15px; } .hardware-style__nav a { font-size:9px; } .hardware-style__main { grid-template-columns:1fr; gap:35px; } .hardware-style__machine { width:calc(100% - 11px); justify-self:start; margin-left:0; } .hardware-style__lower { grid-template-columns:1fr; } .hardware-style__guide { min-height:112px; border-right:0; border-bottom:1px solid var(--line); } .hardware-style__fighter { --scale:3 !important; } .hardware-style__archive { min-height:116px; } }
  @media (max-width:390px) { .hardware-style__header { gap:12px; padding-inline:14px; } .hardware-style__mark { font-size:16px; } .hardware-style__nav { gap:6px 10px; } .hardware-style__main { padding-inline:14px; } .hardware-style__cartridge-label small { display:none; } }
  @media (prefers-reduced-motion:reduce) { .hardware-style *, .hardware-style *::before, .hardware-style *::after { animation-duration:.01ms !important; transition-duration:.01ms !important; } }
  :global(html[data-style-motion='off']) .hardware-style *, :global(html[data-style-motion='off']) .hardware-style *::before, :global(html[data-style-motion='off']) .hardware-style *::after { animation:none !important; transition:none !important; }
</style>
