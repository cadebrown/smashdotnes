---
import { roster } from '../../data/roster';
const spriteStyle = (fighter: typeof roster[number]) => `--sheet:url('/assets/fighters/${fighter.id}.png');--pose:${fighter.pose};--frames:${fighter.frames};--crop-x:${fighter.x};--crop-y:${fighter.y};--crop-width:${fighter.width};--crop-height:${fighter.height}`;
---
<section class="midnight-style" data-midnight aria-label="Midnight style preview">
  <header class="midnight-nav"><a href="/" class="midnight-brand">SMASH<span>.NES</span></a><nav aria-label="Midnight navigation"><a href="/book/">How to play</a><a href="/docs/">Under the hood</a><a href="/play/">Play ↗</a></nav></header>
  <div class="midnight-main">
    <div class="midnight-copy">
      <p class="midnight-format">NES PLATFORM FIGHTER</p>
      <h2>TAKE <br/>THE <span>STAGE.</span></h2>
      <p class="midnight-description">One platform. No safe corner.<br/>Four fighters with a score to settle.</p>
      <a class="midnight-play" href="/play/"><span>Enter the arena</span><b aria-hidden="true">↗</b></a>
      <p class="midnight-note">Browser ready. Controller welcome.</p>
    </div>
    <div class="midnight-showcase">
      <div class="midnight-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="midnight-spotlight" aria-live="polite">
        {roster.map((fighter,index) => <div class="midnight-contender" data-midnight-contender={fighter.id} hidden={index !== 0}>
          <span class="midnight-name" aria-hidden="true">{fighter.name}</span>
          <div class="midnight-sprite" style={spriteStyle(fighter)} role="img" aria-label={`${fighter.name} fighter sprite`}></div>
          <span class="midnight-move">{fighter.move}</span>
        </div>)}
      </div>
      <div class="midnight-platform" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="midnight-select"><span>Choose your fighter</span><div role="group" aria-label="Preview a fighter">{roster.map((fighter,index) => <button type="button" data-midnight-pick={fighter.id} aria-pressed={index === 0} aria-label={`Preview ${fighter.name}`}><span class="midnight-mini" style={spriteStyle(fighter)} aria-hidden="true"></span><b>{fighter.name}</b></button>)}</div></div>
    </div>
  </div>
  <footer class="midnight-bottom"><a href="/book/#controls"><b>Learn the buttons.</b><span>Make the next hit count. ↗</span></a><p>A real NES ROM.<br/><span>Small enough for a cartridge. Built for a fight.</span></p><a class="midnight-rom" href="/rom/smash.nes" download>Take the ROM ↓</a></footer>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-midnight]').forEach(root => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-midnight-pick]')];
    const contenders = [...root.querySelectorAll<HTMLElement>('[data-midnight-contender]')];
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      contenders.forEach(item => { item.hidden = item.dataset.midnightContender !== button.dataset.midnightPick; });
    }));
  });
</script>
<style>
  .midnight-style { --night:#0c0c1b; --night-ink:#f4f3ff; --night-pink:#ff67b6; --night-cyan:#8cf5e9; color:var(--night-ink); background:var(--night); overflow:hidden; font-family:Arial,sans-serif; }
  .midnight-style * { box-sizing:border-box; }
  .midnight-style a { color:inherit; text-decoration:none; }
  .midnight-style :is(a,button):focus-visible { outline:2px solid var(--night-cyan); outline-offset:5px; }
  .midnight-nav { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:30px 5%; border-bottom:1px solid #ffffff1c; }
  .midnight-brand { font:900 italic 28px/1 Arial,sans-serif; letter-spacing:-2px; }
  .midnight-brand span { font-size:15px; color:var(--night-pink); letter-spacing:0; }
  .midnight-nav nav { display:flex; gap:30px; font:700 12px/1.4 Arial,sans-serif; }
  .midnight-nav nav a:last-child { color:var(--night-cyan); }
  .midnight-nav a:hover { color:var(--night-pink); }
  .midnight-main { display:grid; grid-template-columns:1fr 1fr; align-items:center; min-height:590px; gap:20px; padding:48px 5% 40px; }
  .midnight-copy { position:relative; z-index:2; }
  .midnight-format { margin:0 0 25px; color:var(--night-cyan); font:400 8px/1.6 var(--pixel); letter-spacing:.08em; }
  .midnight-copy h2 { margin:0; font:900 italic clamp(60px,7.7vw,106px)/.89 Arial,sans-serif; letter-spacing:-.075em; }
  .midnight-copy h2 span { display:inline-block; color:var(--night-pink); }
  .midnight-description { margin:28px 0; font:400 16px/1.6 Arial,sans-serif; color:#babacf; }
  .midnight-play { display:flex; justify-content:space-between; align-items:center; gap:50px; width:fit-content; padding:18px 22px; background:var(--night-cyan); color:#0c0c1b !important; font:700 15px/1 Arial,sans-serif; transform:skewX(-7deg); transition:background .18s,translate .18s; }
  .midnight-play > * { transform:skewX(7deg); }
  .midnight-play b { font-size:25px; }
  .midnight-play:hover { background:#fff; translate:3px -3px; }
  .midnight-note { margin:14px 0 0; color:#85859d; font:400 11px/1.5 var(--mono); }
  .midnight-showcase { position:relative; isolation:isolate; min-width:0; padding:35px 10px 0; }
  .midnight-orbit { position:absolute; z-index:-1; top:15px; left:10%; right:5%; height:350px; transform:rotate(-20deg); }
  .midnight-orbit i { position:absolute; inset:0; border:1px solid #8cf5e947; border-radius:50%; }
  .midnight-orbit i:nth-child(2) { inset:22px -24px; border-color:#ff67b647; transform:rotate(32deg); }
  .midnight-orbit i:nth-child(3) { inset:50px -50px; border-color:#7564ea70; transform:rotate(55deg); }
  .midnight-spotlight { position:relative; height:320px; }
  .midnight-contender { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; }
  .midnight-contender[hidden] { display:none; }
  .midnight-name { position:absolute; top:0; left:0; right:0; color:#ffffff0b; font:900 italic clamp(65px,7.5vw,104px)/1 Arial,sans-serif; text-align:center; letter-spacing:-.055em; }
  .midnight-sprite,.midnight-mini { --scale:7; display:block; flex-shrink:0; width:calc(var(--crop-width) * var(--scale) * 1px); height:calc(var(--crop-height) * var(--scale) * 1px); background:var(--sheet) no-repeat; background-size:calc(var(--frames) * 32px * var(--scale)) calc(40px * var(--scale)); background-position:calc((var(--pose) * 32 + var(--crop-x)) * var(--scale) * -1px) calc(var(--crop-y) * var(--scale) * -1px); image-rendering:pixelated; position:relative; z-index:1; }
  .midnight-move { margin-top:20px; color:var(--night-cyan); font:400 8px/1.4 var(--pixel); }
  .midnight-platform { height:44px; position:relative; margin:20px 5% 28px; }
  .midnight-platform i { position:absolute; inset:0 0 auto; height:12px; border:1px solid #8cf5e9; transform:skewX(-45deg); }
  .midnight-platform i:nth-child(2) { top:10px; inset-inline:8px; opacity:.45; }
  .midnight-platform i:nth-child(3) { top:20px; inset-inline:16px; opacity:.2; }
  .midnight-select > span { display:block; margin-bottom:12px; font:400 11px/1.4 var(--mono); text-align:center; color:#b9b8d0; }
  .midnight-select > div { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
  .midnight-select button { min-width:0; padding:10px 3px; display:flex; flex-direction:column; justify-content:flex-end; align-items:center; gap:10px; height:125px; color:#babacf; border:1px solid #343346; border-radius:0; background:#171626; cursor:pointer; transition:background .18s,border-color .18s; }
  .midnight-select button[aria-pressed=true] { color:var(--night-cyan); border-color:var(--night-cyan); background:#20243b; }
  .midnight-select button:hover { border-color:var(--night-pink); }
  .midnight-mini { --scale:2; }
  .midnight-select b { font:700 10px/1.2 Arial,sans-serif; text-transform:uppercase; letter-spacing:.08em; }
  .midnight-bottom { display:grid; grid-template-columns:1fr 1.3fr auto; align-items:center; gap:30px; padding:28px 5%; border-top:1px solid #ffffff1c; }
  .midnight-bottom a:first-child { display:grid; gap:8px; }
  .midnight-bottom b { font-size:17px; }
  .midnight-bottom span { color:#aaa9c1; font:400 12px/1.6 Arial,sans-serif; }
  .midnight-bottom p { font:700 13px/1.7 Arial,sans-serif; margin:0; }
  .midnight-rom { color:var(--night-cyan) !important; font:400 11px/1.5 var(--mono); }
  @media(prefers-reduced-motion:no-preference) {
    :global(html:not([data-style-motion=off])) .midnight-contender:not([hidden]) .midnight-sprite { animation:midnight-enter .5s cubic-bezier(.16,1,.3,1) both; }
    :global(html:not([data-style-motion=off])) .midnight-orbit { animation:midnight-orbit-arrive 1s cubic-bezier(.16,1,.3,1) both; }
  }
  @keyframes midnight-enter { from { opacity:0; transform:translate(25px,-20px); } to { opacity:1; transform:translate(0,0); } }
  @keyframes midnight-orbit-arrive { from { opacity:0; transform:rotate(-65deg) scale(.7); } to { opacity:1; transform:rotate(-20deg) scale(1); } }
  :global(html[data-style-motion=off]) .midnight-style * { animation:none !important; transition:none !important; }
  @media(max-width:900px) {
    .midnight-main { padding-top:36px; }
    .midnight-copy h2 { font-size:clamp(52px,7.7vw,80px); }
    .midnight-sprite { --scale:5; }
    .midnight-nav nav { gap:18px; }
    .midnight-bottom { grid-template-columns:1fr 1fr; }
    .midnight-bottom .midnight-rom { grid-column:1/-1; }
  }
  @media(max-width:620px) {
    .midnight-nav { padding-block:22px; flex-wrap:wrap; gap:20px; }
    .midnight-nav nav { gap:22px; font-size:11px; }
    .midnight-main { grid-template-columns:1fr; gap:26px; padding-top:35px; }
    .midnight-copy h2 { font-size:clamp(60px,12vw,80px); }
    .midnight-copy h2 br { display:none; }
    .midnight-copy h2 span { display:block; }
    .midnight-description { margin:22px 0; }
    .midnight-showcase { padding:20px 0 0; }
    .midnight-orbit { height:270px; }
    .midnight-spotlight { height:230px; }
    .midnight-select button { height:125px; }
    .midnight-name { font-size:72px; }
    .midnight-bottom { grid-template-columns:1fr; gap:24px; }
  }
</style>
