---
import { readFile } from 'node:fs/promises';
type Meta = { id: string; display_name: string; frames: Array<{ name: string; x: number; w: number }>; animations: Array<{ name: string; frame_indices: number[]; frame_duration: number }> };
const ids = ['mario', 'simon', 'tommy', 'rizer'];
const roster = await Promise.all(ids.map(async (id) => JSON.parse(await readFile(new URL(`../../../../src/chars/${id}/generated/meta.json`, import.meta.url), 'utf8')) as Meta));
const activeWindows: Record<string, Record<string, [number, number] | undefined>> = { mario: { jab: [3, 5], special: [4, 7] }, simon: { jab: [5, 9], special: [5, 9] }, tommy: { jab: [3, 5], special: [4, 7] }, rizer: { jab: [3, 5], special: [4, 7] } };
const data = roster.map((fighter) => ({ id: fighter.id, name: fighter.display_name, image: `/assets/fighters/${fighter.id}.png`, imageWidth: Math.max(...fighter.frames.map((frame) => frame.x + frame.w)), frames: fighter.frames.map((frame) => frame.name), animations: Object.fromEntries(fighter.animations.filter((animation) => ['walk', 'jump', 'jab', 'special'].includes(animation.name)).map((animation) => [animation.name, { frames: animation.frame_indices, duration: animation.frame_duration, active: animation.name === 'jab' || (fighter.id === 'tommy' && animation.name === 'special') ? activeWindows[fighter.id][animation.name] ?? null : null }])) }));
---
<section class="viewer" data-animation-viewer aria-labelledby="animation-viewer-title">
  <div><p class="eyebrow">Generated source data</p><h2 id="animation-viewer-title">Animation timeline viewer</h2><p>Choose a fighter and action, then scrub the authored frame timeline. Poses and frame durations come from generated fighter metadata; attack windows come from the matching character specification.</p></div>
  <script is:inline type="application/json" data-animation-data set:html={JSON.stringify(data)}></script>
  <div class="picker"><label>Fighter <select data-fighter aria-label="Choose a fighter">{data.map((fighter) => <option value={fighter.id}>{fighter.name}</option>)}</select></label><label>Action <select data-action aria-label="Choose an animation"><option value="walk">Walk</option><option value="jump">Jump</option><option value="jab">Jab</option><option value="special">Special</option></select></label></div>
  <div class="stage"><div class="pose" data-pose><img data-sheet alt="Selected source-sprite pose" loading="lazy"/></div><div><p data-caption aria-live="polite"></p><label class="scrubber">Tick <input data-tick type="range" min="0" value="0" /><output data-tick-output>0</output></label><div data-timeline class="timeline" aria-label="Ordered pose strip"></div><p class="note">Orange means collision is active for a melee action. Projectile specials launch on accepted input; their visual timeline is not projectile startup.</p></div></div>
</section>
<script>
  type Animation = { frames: number[]; duration: number; active: [number, number] | null };
  type Fighter = { id: string; name: string; image: string; imageWidth: number; frames: string[]; animations: Record<string, Animation> };
  const root = document.querySelector<HTMLElement>('[data-animation-viewer]');
  if (root) {
    const raw = root.querySelector<HTMLScriptElement>('[data-animation-data]'); const fighterSelect = root.querySelector<HTMLSelectElement>('[data-fighter]'); const actionSelect = root.querySelector<HTMLSelectElement>('[data-action]'); const sheet = root.querySelector<HTMLImageElement>('[data-sheet]'); const pose = root.querySelector<HTMLElement>('[data-pose]'); const caption = root.querySelector<HTMLElement>('[data-caption]'); const tick = root.querySelector<HTMLInputElement>('[data-tick]'); const tickOutput = root.querySelector<HTMLOutputElement>('[data-tick-output]'); const timeline = root.querySelector<HTMLElement>('[data-timeline]');
    if (raw && fighterSelect && actionSelect && sheet && pose && caption && tick && tickOutput && timeline) {
      const fighterData = JSON.parse(raw.textContent ?? '[]') as Fighter[];
      const update = () => { const fighter = fighterData.find((item) => item.id === fighterSelect.value); if (!fighter) return; const animation = fighter.animations[actionSelect.value]; if (!animation) return; const currentTick = Math.min(Number(tick.value), animation.frames.length * animation.duration - 1); const phase = Math.floor(currentTick / animation.duration); const frameIndex = animation.frames[phase]; const frameName = fighter.frames[frameIndex]; const active = animation.active && currentTick >= animation.active[0] && currentTick <= animation.active[1]; sheet.src = fighter.image; sheet.style.transform = `translateX(-${frameIndex * 128}px)`; sheet.style.width = `${fighter.imageWidth * 4}px`; pose.dataset.active = active ? 'true' : 'false'; tickOutput.value = String(currentTick); caption.textContent = `${fighter.name} · ${actionSelect.value} · tick ${currentTick} · ${frameName}${active ? ' · collision active' : ''}`; timeline.innerHTML = animation.frames.map((index, position) => { const start = position * animation.duration; const end = start + animation.duration - 1; const hit = animation.active && end >= animation.active[0] && start <= animation.active[1]; return `<button type="button" data-phase="${position}" class="phase ${position === phase ? 'selected' : ''} ${hit ? 'active' : ''}" aria-pressed="${position === phase}"><span class="thumb" style="background-image:url('${fighter.image}');background-size:${fighter.imageWidth * 1.25}px 50px;background-position:-${index * 40}px 0"></span><b>${position + 1}</b><span>${fighter.frames[index].replace('_', ' ')}</span><small>${start}–${end}${hit ? ' active' : ''}</small></button>`; }).join(''); timeline.querySelectorAll<HTMLButtonElement>('[data-phase]').forEach((button) => button.addEventListener('click', () => { tick.value = String(Number(button.dataset.phase) * animation.duration); update(); })); };
      const reset = () => { const fighter = fighterData.find((item) => item.id === fighterSelect.value); const animation = fighter?.animations[actionSelect.value]; if (animation) { tick.max = String(animation.frames.length * animation.duration - 1); tick.value = '0'; } update(); };
      fighterSelect.addEventListener('change', reset); actionSelect.addEventListener('change', reset); tick.addEventListener('input', update); reset();
    }
  }
</script>
<style>
 .viewer{background-image:var(--grit);border:2px solid var(--sl-color-gray-4);border-inline-start:6px solid var(--gold,#d6af56);margin:2rem 0;padding:1.2rem}.viewer h2{margin:.2rem 0}.eyebrow{color:var(--gold,#d6af56);font:16px/1 var(--pixel,monospace);letter-spacing:.08em;text-transform:uppercase}.picker{display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0}.picker select{background:var(--sl-color-bg);border:1px solid var(--gold,#d6af56);border-radius:0;color:var(--sl-color-white);margin-left:.35rem}.stage{display:grid;grid-template-columns:160px 1fr;gap:1.2rem;align-items:start}.pose{box-sizing:content-box;height:160px;width:128px;overflow:hidden;background:var(--black,#0c0c0b);border:4px solid var(--gold,#d6af56)}.pose[data-active=true]{border-color:var(--ember,#ed603e)}.pose img{display:block;height:160px;max-width:none;image-rendering:pixelated}.scrubber{display:flex;gap:.5rem;align-items:center;font-family:var(--mono);font-size:.85rem}.scrubber input{accent-color:var(--ember,#ed603e);flex:1}.timeline{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1rem}.viewer :global(.phase){display:grid;grid-template-columns:42px auto;grid-template-rows:auto auto;gap:.15rem .45rem;align-items:center;text-align:left;padding:.35rem;border:1px solid var(--sl-color-gray-4);border-radius:0;background:var(--sl-color-bg);color:var(--sl-color-white);font-size:.72rem}.viewer :global(.phase:hover){border-color:var(--gold,#d6af56)}.viewer :global(.phase.selected){outline:2px solid var(--gold,#d6af56);outline-offset:2px}.viewer :global(.phase.active){border-inline-start:4px solid var(--ember,#ed603e)}.viewer :global(.thumb){grid-row:1 / 3;width:40px;height:50px;background-repeat:no-repeat;image-rendering:pixelated}.viewer :global(.phase b){font-family:var(--mono)}.viewer :global(.phase small){color:var(--sl-color-gray-2)}.note{font-size:.82rem;color:var(--sl-color-gray-2)}@media(max-width:600px){.stage{grid-template-columns:1fr}.pose{margin:auto}.eyebrow{font-size:8px}}
</style>
