---
import AnnotatedScreenshot from './AnnotatedScreenshot.astro';
import type { ManualScene } from '../../data/manual-annotations';
const scenes = [
  { scene:'jump' as ManualScene, id:'jump', label:'Jump', image:'05_jump', alt:'Mario airborne above the platform while Simon stands near the opposite edge', title:'Keep one jump in reserve.', caption:'The first gets you off the ground. The second can get you home.', href:'/book/#save-the-second-jump' },
  { scene:'lobby' as ManualScene, id:'choose', label:'Choose', image:'02_lobby', alt:'The native fighter selection screen with Mario, Simon, Tommy, and Rizer', title:'Four fighters. Four approaches.', caption:'A fireball, an axe, a flying kick, or a straight shot. Find your distance.', href:'/book/#fighters' },
  { scene:'jab' as ManualScene, id:'attack', label:'Attack', image:'06_jab', alt:'Mario extending his kick with Simon standing outside its reach', title:'A button press is only the start.', caption:'This kick misses. Distance and the contact window both have to line up.', href:'/book/#combat' },
];
---
<section class="book-scenes" data-book-scenes aria-label="A look inside the game">
  <div class="scene-tabs" role="tablist" aria-label="Manual preview">
    {scenes.map((scene,index)=><button type="button" role="tab" id={`scene-tab-${scene.id}`} aria-controls={`scene-${scene.id}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1}>{scene.label}</button>)}
  </div>
  {scenes.map((scene,index)=><div role="tabpanel" id={`scene-${scene.id}`} aria-labelledby={`scene-tab-${scene.id}`} tabindex="0" hidden={index!==0}>
    <AnnotatedScreenshot scene={scene.scene} compact />
    <div class="scene-caption"><strong>{scene.title}</strong><p>{scene.caption}</p><a href={scene.href}>Read the lesson <span aria-hidden="true">↗</span></a></div>
  </div>)}
  <p class="capture-credit">Captured from the playable ROM.</p>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-book-scenes]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab,i) => {tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex=i===index?0:-1; panels[i].hidden=i!==index;});
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab,index) => {
      tab.addEventListener('click',() => select(index));
      tab.addEventListener('keydown',event => {
        const next = event.key==='ArrowRight' ? (index+1)%tabs.length : event.key==='ArrowLeft' ? (index+tabs.length-1)%tabs.length : event.key==='Home' ? 0 : event.key==='End' ? tabs.length-1 : -1;
        if (next>=0) {event.preventDefault(); select(next,true);}
      });
    });
  }
</script>
