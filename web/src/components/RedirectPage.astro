---
interface Props { target:string; }
const {target}=Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="robots" content="noindex"/><title>Page moved · Smash.NES</title><link rel="canonical" href={new URL(target,Astro.site)}/>
<script is:inline define:vars={{target}}>
  const destination=new URL(target,window.location.origin);
  destination.search=window.location.search;
  if(window.location.hash)destination.hash=window.location.hash;
  window.location.replace(destination.href);
</script>
<noscript><meta http-equiv="refresh" content={`0;url=${target}`}/></noscript>
</head><body><a href={target}>Continue to Smash.NES</a></body></html>
