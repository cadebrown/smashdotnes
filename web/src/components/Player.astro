---
import '../styles/player.css';
---
      <div class="player-surface">
        <div class="console-bezel"><div class="console-label" aria-hidden="true"><span>SMASH.NES</span><span><i class="console-lamp"></i>8-BIT PLATFORM FIGHTER</span></div>
        <div class="game-frame">
          <div id="game" role="application" tabindex="0"
            aria-label="Smash.NES game emulator" aria-describedby="controls-help"></div>
        </div>
        </div>
        <p id="status" class="game-status" role="status" aria-live="polite">Loading game…</p>
        <noscript><p>Enable JavaScript to play here, or download the ROM for your NES emulator.</p></noscript>

        <section id="controls-help" class="controls" aria-label="Game controls">
          <p class="keyboard-hint">Click the game, then press <kbd>Enter</kbd> to start. <kbd>Tab</kbd> leaves the game.</p>
          <p class="touch-hint">Tap Start to begin. A jabs; B uses your special.</p>
          <ul class="keyboard-controls">
            <li><kbd>A</kbd><kbd>D</kbd> Move</li>
            <li><kbd>W</kbd> Jump</li>
            <li><kbd>W</kbd><kbd>S</kbd> Menu</li>
            <li><kbd>J</kbd> Jab</li>
            <li><kbd>K</kbd> Special</li>
          </ul>
          <details class="play-help">
            <summary>How to play</summary>
            <p>Build damage, then knock your opponent off the stage. Jump again in the air to double jump.</p>
            <p>Use the controller icon to change keys or set up a gamepad. The restart icon returns to the title screen.</p>
          </details>
        </section>
      </div>
    <script is:inline src="/input-focus.js"></script>
    <script is:inline>
      window.EJS_player = "#game";
      window.EJS_core = "nes";
      window.EJS_gameUrl = "/rom/smash.nes";
      window.EJS_gameName = "SmashDotNES";
      window.EJS_pathtodata = "/assets/emulatorjs/data/";
      window.EJS_startOnLoaded = true;
      window.EJS_backgroundColor = "#000000";
      window.EJS_color = "#a83222";
      window.EJS_threads = false;
      window.EJS_disableDatabases = true;
      window.EJS_noAutoFocus = true;
      window.EJS_language = "en-US";
      window.EJS_disableAutoLang = false;
      window.EJS_paths = { "version.json": "/assets/emulatorjs/data/version.json" };

      function setRuntimeStatus(message) {
        document.getElementById("status").textContent = message;
      }

      window.EJS_Buttons = {
        restart: true, playPause: true, mute: true, volumeSlider: true,
        gamepad: true, fullscreen: true,
        settings: false, saveState: false, loadState: false,
        saveSavFiles: false, loadSavFiles: false, cheat: false,
        cacheManager: false, netplay: false, diskButton: false,
        exitEmulation: false, screenshot: false, screenRecord: false,
        quickSave: false, quickLoad: false
      };

      window.EJS_VirtualGamepadSettings = [
        { type: "button", text: "B", id: "b", location: "right", right: 75, top: 70, bold: true, input_value: 0 },
        { type: "button", text: "A", id: "a", location: "right", right: 5, top: 70, bold: true, input_value: 8 },
        { type: "dpad", id: "dpad", location: "left", left: "50%", right: "50%", joystickInput: false, inputValues: [4, 5, 6, 7] },
        { type: "button", text: "Start", id: "start", location: "center", left: 60, fontSize: 15, block: true, input_value: 3 },
        { type: "button", text: "Select", id: "select", location: "center", left: -5, fontSize: 15, block: true, input_value: 2 }
      ];

      window.EJS_onGameStart = function onGameStart() {
        const emulator = window.EJS_emulator;
        window.installKeyboardFocusRelease(emulator);
        // This vendored version ignores contextMenu in EJS_Buttons.
        const menu = emulator.elements.bottomBar.contextMenu?.[0];
        if (menu) menu.hidden = true;
        setRuntimeStatus("Game ready");
        document.documentElement.dataset.emulator = "running";
      };

      document.getElementById("game").addEventListener("pointerdown", function focusEmulator() {
        this.focus({ preventScroll: true });
      });

      window.addEventListener("keydown", function releaseTabFromEmulator(event) {
        if (event.key === "Tab") event.stopImmediatePropagation();
      }, true);

      (function patchVersionFetchForOffline() {
        const remoteVersion = "https://cdn.emulatorjs.org/stable/data/version.json";
        const localVersion = "/assets/emulatorjs/data/version.json";
        if (typeof window.fetch !== "function") return;
        const originalFetch = window.fetch.bind(window);
        window.fetch = function patchedFetch(input, init) {
          const requestUrl = typeof input === "string" ? input : (input && input.url) || "";
          if (requestUrl === remoteVersion) return originalFetch(localVersion, init);
          return originalFetch(input, init);
        };
      })();

      window.EJS_defaultControls = {
        0: {
          0: { value: "k", value2: "BUTTON_2" },
          1: { value: "", value2: "BUTTON_4" },
          2: { value: "single quote", value2: "SELECT" },
          3: { value: "enter", value2: "START" },
          4: { value: "w", value2: "DPAD_UP" },
          5: { value: "s", value2: "DPAD_DOWN" },
          6: { value: "a", value2: "DPAD_LEFT" },
          7: { value: "d", value2: "DPAD_RIGHT" },
          8: { value: "j", value2: "BUTTON_1" },
          9: { value: "", value2: "BUTTON_3" },
          10: { value: "", value2: "LEFT_TOP_SHOULDER" },
          11: { value: "", value2: "RIGHT_TOP_SHOULDER" },
          12: { value: "", value2: "LEFT_BOTTOM_SHOULDER" },
          13: { value: "", value2: "RIGHT_BOTTOM_SHOULDER" },
          14: { value: "", value2: "LEFT_STICK" },
          15: { value: "", value2: "RIGHT_STICK" },
          16: { value: "", value2: "LEFT_STICK_X:+1" },
          17: { value: "", value2: "LEFT_STICK_X:-1" },
          18: { value: "", value2: "LEFT_STICK_Y:+1" },
          19: { value: "", value2: "LEFT_STICK_Y:-1" },
          20: { value: "", value2: "RIGHT_STICK_X:+1" },
          21: { value: "", value2: "RIGHT_STICK_X:-1" },
          22: { value: "", value2: "RIGHT_STICK_Y:+1" },
          23: { value: "", value2: "RIGHT_STICK_Y:-1" },
          24: { value: "1" },
          25: { value: "2" },
          26: { value: "3" },
          27: { value: "add" },
          28: { value: "space" },
          29: { value: "subtract" }
        },
        1: {},
        2: {},
        3: {}
      };
    </script>
    <script is:inline
      src="/assets/emulatorjs/data/loader.js"
      onerror="setRuntimeStatus('Could not load the game. Reload this page to try again.')"
    ></script>
