---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeArena from '../components/HomeArena.astro';
import { sectionEntries, formatDate } from '../data/sections';
const latest = (await sectionEntries('blog'))[0];
---
<SiteLayout title="Smash.NES">
  <HomeArena />
  <div class="home-links">
    <a href="/book/"><h2>Learn the moves <span aria-hidden="true">↗</span></h2><p>Meet the fighters. Find your special. Stay on the platform.</p></a>
    <a href="/docs/"><h2>Inside the cartridge <span aria-hidden="true">↗</span></h2><p>From editable sprites to a working NES ROM. Build your own.</p></a>
    {latest && <a class="latest-post" href={`/${latest.id}/`}><small>Latest post{latest.data.date && ` · ${formatDate(latest.data.date)}`}</small><h2>{latest.data.title} <span aria-hidden="true">↗</span></h2></a>}
  </div>
</SiteLayout>
